# ============================================================
# .env — Variables d'environnement FastAPI Python (example)
# ============================================================

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
# Timeout global (en secondes) pour les appels Ollama
OLLAMA_TIMEOUT=300
# Timeout spécifique au chat (fallback: OLLAMA_TIMEOUT)
OLLAMA_CHAT_TIMEOUT=300
# Timeout spécifique à la génération des test cases (fallback: OLLAMA_TIMEOUT)
OLLAMA_TEST_CASES_TIMEOUT=300
# Timeout spécifique à la génération des test plans (fallback: OLLAMA_TIMEOUT)
OLLAMA_TEST_PLANS_TIMEOUT=300
# Timeout spécifique à l'interprétation des test cases en execution_model/v1
OLLAMA_TEST_TRANSLATOR_TIMEOUT=180

APP_HOST=127.0.0.1
APP_PORT=8000

# Node/Mongo owner of durable spec-ingestion snapshots and review decisions.
BACKEND_API_BASE_URL=http://localhost:3000
# Must match backend-2026 INTERNAL_API_TOKEN (or its FASTAPI_SECRET fallback).
INTERNAL_API_TOKEN=

# USE_MOCK=true  -> retourne des données statiques sans appeler Ollama
# USE_MOCK=false -> appelle vraiment Ollama mistral
USE_MOCK=false

# DEBUG_ERRORS=true -> ajoute un champ "detail" dans les erreurs API (dev only)
DEBUG_ERRORS=false
