# ============================================================
# FastAPI / python-2026 environment example
# Copy this file to .env and replace placeholder secrets.
# Never commit the populated .env file.
# ============================================================

# ---------------- OpenRouter ----------------
# Required when USE_MOCK=false.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Timeouts are in seconds. Operation-specific values fall back to
# OPENROUTER_TIMEOUT when omitted.
OPENROUTER_TIMEOUT=120
OPENROUTER_CHAT_TIMEOUT=120
OPENROUTER_TEST_PLANS_TIMEOUT=120
OPENROUTER_TEST_CASES_TIMEOUT=300
OPENROUTER_TEST_TRANSLATOR_TIMEOUT=180

# Default generation controls used by utils/openrouter.py.
OPENROUTER_TEMPERATURE=0.1
OPENROUTER_MAX_TOKENS=1500

# ---------------- Module embeddings ----------------
# sentence-transformers downloads paraphrase-multilingual-MiniLM-L12-v2 on
# first use during POST /generate-plan. Cache it in a durable directory.
HF_HOME=.cache/huggingface
# Optional but recommended to avoid anonymous Hugging Face rate limits.
HF_TOKEN=

# ---------------- Node/Mongo ingestion store ----------------
# Node owns durable ingestion items, module versions, and review decisions.
BACKEND_API_BASE_URL=http://127.0.0.1:3000

# Required. Must exactly match backend-2026 INTERNAL_API_TOKEN.
# Generate one long random value and put the same value in both .env files.
INTERNAL_API_TOKEN=replace-with-a-long-random-shared-token

# ---------------- FastAPI process ----------------
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# USE_MOCK=true disables supported external AI calls in development.
USE_MOCK=false

# Adds internal exception details to selected API errors. Development only.
DEBUG_ERRORS=false

# ---------------- Legacy Ollama adapter (optional) ----------------
# The current plan/case pipeline uses OpenRouter. These are needed only if the
# legacy utils/ollama.py or services/ai/ai_service.py adapters are invoked.
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:3b-instruct
# OLLAMA_TIMEOUT=300
# OLLAMA_HTTP_TIMEOUT=300
# OLLAMA_NUM_CTX=4096
# OLLAMA_NUM_PREDICT=800
# OLLAMA_TEMPERATURE=0.7
