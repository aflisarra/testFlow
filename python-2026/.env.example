# ============================================================
# .env — Variables d'environnement FastAPI Python (example)
# ============================================================

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

APP_HOST=127.0.0.1
APP_PORT=8000

# USE_MOCK=true  -> retourne des données statiques sans appeler Ollama
# USE_MOCK=false -> appelle vraiment Ollama llama3
USE_MOCK=false

