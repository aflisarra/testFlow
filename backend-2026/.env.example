# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/pfe1-2026

# JWT Secret
JWT_SECRET=your-secret-key-pfe-2026-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-pfe-2026-change-in-production

# xAI (Grok) - OpenAI compatible



# FastAPI (Ollama/llama3)
FASTAPI_BASE_URL=http://localhost:8000
