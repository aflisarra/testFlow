# ============================================================
# Express / backend-2026 environment example
# Copy this file to .env and replace placeholder secrets.
# Never commit the populated .env file.
# ============================================================

# ---------------- MongoDB ----------------
MONGODB_URI=mongodb://127.0.0.1:27017/pfe1-2026

# ---------------- Authentication ----------------
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret

# ---------------- FastAPI integration ----------------
FASTAPI_BASE_URL=http://127.0.0.1:8000

# Axios timeout in milliseconds for upload, module/plan, and case generation.
FASTAPI_TIMEOUT_MS=420000

# Token Node sends to protected FastAPI worker routes.
# Use the same shared value as INTERNAL_API_TOKEN unless the services are
# deliberately configured with separate inbound/outbound credentials.
FASTAPI_SECRET=replace-with-a-long-random-shared-token

# Protects /api/internal/spec-ingestions, including module claim/commit routes.
# Must exactly match python-2026 INTERNAL_API_TOKEN.
INTERNAL_API_TOKEN=replace-with-a-long-random-shared-token

# ---------------- HTTP server ----------------
PORT=3000
NODE_ENV=development

# Comma-separated browser origins. Do not use * in production.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
