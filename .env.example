# =============================================================
# .env.example — Root-level shared secrets template
# Copy this to .env and fill in real values.
# The values here are only used when docker-compose.yml reads
# them via ${VAR} substitution (currently not needed since each
# service has its own .env). Add root-level vars here if you
# ever want to centralise the shared token or port overrides.
# =============================================================

# Shared internal API token — must match both service .env files:
#   backend-2026/.env  → INTERNAL_API_TOKEN
#   python-2026/.env   → INTERNAL_API_TOKEN
# INTERNAL_API_TOKEN=replace-with-a-long-random-shared-token

# Optional: override published ports for the host machine
# BACKEND_PORT=3000
# PYTHON_PORT=8000
# FRONT_PORT=4200
